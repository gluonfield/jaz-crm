# Copy to .env to configure docker compose. Sign-in needs an OpenID Connect
# provider (OIDC_*); syncing needs Google (GOOGLE_*, ENCRYPTION_KEY).

# The URL people and agents reach Jaz CRM at. It is the only source for the
# OIDC and Google redirect URIs, the OAuth issuer and metadata URLs, and the
# session cookie's domain. An https URL also turns on Calendar push.
PUBLIC_URL=http://localhost:7500

# Sign-in with any OpenID Connect provider. For Google, create an OAuth client
# (Web application) and add PUBLIC_URL/auth/callback as a redirect URI.
#   OIDC_ISSUER=https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional sign-in restriction, comma-separated. With both empty, anyone with
# a verified email may sign in; each new person gets a workspace of their
# own and joins others only by invite.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Optional account a deployment starts with, so agents such as Jaz work
# without anyone signing in. OWNER_API_KEY, at least 32 random characters
# (openssl rand -hex 32), is registered as that account's key.
OWNER_EMAIL=
OWNER_API_KEY=

# Syncing Gmail, Calendar and Meet transcripts. Use a Web application OAuth
# client with PUBLIC_URL/connections/google/callback as a redirect URI; enable
# the Gmail, Calendar and Meet APIs in its project. The same client can serve
# sign-in. Refresh tokens are encrypted with ENCRYPTION_KEY, 32 bytes in
# base64 (openssl rand -base64 32); changing it disconnects every account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=

# How many days back a new connection syncs.
BACKFILL_DAYS=730

# Optional Gmail push: a Pub/Sub topic Gmail may publish to, with a push
# subscription to PUBLIC_URL/webhooks/google/gmail that authenticates as
# GMAIL_PUBSUB_SERVICE_ACCOUNT with that URL as audience. Without it, mail
# syncs every five minutes.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# Optional triage agent: any OpenAI-compatible endpoint. It judges addresses
# no evidence settles against the workspace description. Without a model,
# those addresses wait for a person or an agent over MCP.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Temporal Cloud instead of the compose Temporal: its address, namespace and
# an API key.
# TEMPORAL_ADDRESS=
# TEMPORAL_NAMESPACE=
# TEMPORAL_API_KEY=
