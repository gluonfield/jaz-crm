# Copy to .env to configure docker compose. Sign-in needs an OpenID Connect
# provider (OIDC_*); the rest is optional.

# The URL people and agents reach Jaz CRM at. It is the only source for the
# OIDC redirect URI (PUBLIC_URL/auth/callback), the OAuth issuer and metadata
# URLs, and the session cookie's domain.
PUBLIC_URL=http://localhost:7500

# Sign-in with any OpenID Connect provider. For Google, create an OAuth client
# (Web application) in Google Cloud Console > APIs & Services > Credentials
# and add PUBLIC_URL/auth/callback as an authorized redirect URI.
#   OIDC_ISSUER=https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional sign-in restriction, comma-separated. With both empty, anyone with
# a verified email may sign in; each new person gets a workspace of their
# own and joins others only by invite.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Optional account a deployment starts with, so agents such as Jaz work
# without anyone signing in. OWNER_EMAIL's account is created on first start
# with a workspace of its own; whoever later signs in with that email takes
# it over. OWNER_API_KEY, at least 32 random characters (openssl rand -hex
# 32), is registered as that account's key; replacing it retires the old one.
OWNER_EMAIL=
OWNER_API_KEY=
